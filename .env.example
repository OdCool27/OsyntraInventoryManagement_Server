# Copy to .env and fill in the blank values before the first application start.
# Preserved PostgreSQL connection for the explicit postgres profile and Compose.
# The default local MVP and tests use separate SQLite databases.
POSTGRES_DB=sentra_inventory
POSTGRES_USER=sentra
POSTGRES_PASSWORD=

# Optional SQLite MVP file path (default: osyntra-mvp.db).
# SQLITE_DB_PATH=osyntra-mvp.db

# First platform operator; existing SENTRA_ADMIN names remain fallback variables.
# Existing accounts are never converted or have their passwords reset.
# Swagger username is this email, NOT POSTGRES_USER.
# Password: 12-72 characters, at most 72 UTF-8 bytes.
# Spring does not generate or log a default password.
SENTRA_ADMIN_EMAIL=
SENTRA_ADMIN_PASSWORD=

# Optional preferred operator variables (use a distinct email if a legacy owner exists).
# OSYNTRA_OPERATOR_EMAIL=
# OSYNTRA_OPERATOR_PASSWORD=

# Opt-in sqlite,demo profile only; choose a local password, never a default.
# OSYNTRA_DEMO_PASSWORD=

# Separate frontend CORS origin(s), comma-separated.
# OSYNTRA_ALLOWED_ORIGINS=http://localhost:5173
